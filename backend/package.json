{
  "name": "onda-salon-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Onda Hair Studio: auth, services, stylists, appointments, availability and statistics.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning src/server.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch src/server.js",
    "seed": "node --no-warnings=ExperimentalWarning src/seed.js"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.2",
    "swagger-ui-express": "5.0.1"
  }
}
